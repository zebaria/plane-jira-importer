# Jira Cloud configuration
JIRA_HOST=your-domain.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your-jira-api-token

# Plane configuration
PLANE_HOST=https://your-plane-instance.com
PLANE_WORKSPACE_SLUG=your-workspace-slug

# Plane API tokens. The migration uses two distinct roles:
#  - PLANE_PERSONAL_API_KEY: for bootstrap scripts (pull users,
#    invite, seed-members, create-bot-token). Authorise with your
#    own identity.
#  - PLANE_BOT_API_KEY:      for the importer + post-passes
#    (renumber, sprint mapping, image rewrite). Service-account
#    token so created work items / comments attribute to the bot.
#
# Single-token setups can use just PLANE_API_KEY as a fallback.
# PLANE_PERSONAL_API_KEY=plane_api_...
# PLANE_BOT_API_KEY=plane_api_...
PLANE_API_KEY=your-plane-api-key

# Optional tuning (defaults shown)
# JIRA_RATE_LIMIT=30          # Jira API requests per minute
# PLANE_RATE_LIMIT=60         # Plane API requests per minute
# MAX_RETRIES=3               # Retry attempts for transient failures
# MAX_ATTACHMENT_SIZE_MB=100  # Skip attachments larger than this (0 = no limit)
# DEBUG=1                     # Show stack traces on errors
